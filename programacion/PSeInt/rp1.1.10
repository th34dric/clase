Algoritmo sin_titulo
	Escribir 'inserte un caracter'
	Leer caracter
	Escribir 'inserte dos numeros enteros'
	Leer num1, num2
	Según caracter Hacer
		'+':
			suma <- num1+num2
			Escribir 'la suma es ', suma
		'-':
			resta <- num1-num2
			Escribir 'la resta es ', resta
		'*':
			multi <- num1*num2
			Escribir 'la multiplicacion es ', multi
		'/':
			Si num2 == 0 Entonces
				Escribir 'no se puede dividir por 0'
			SiNo
				division <- num1/num2
				Escribir 'la division es ', division
			FinSi
		De Otro Modo:
			Escribir 'ERROR'
	FinSegún
FinAlgoritmo
