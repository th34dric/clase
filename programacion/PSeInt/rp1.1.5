Algoritmo sin_titulo
	Escribir 'Introduce 4 numeros'
	Leer n1, n2, n3, n4
	media <- (n1+n2+n3+n4)/4
	Escribir "la media es " media
	Si media<n1 Entonces
		Escribir n1
	FinSi
	Si media<n2 Entonces
		Escribir n2
	FinSi
	Si media<n3 Entonces
		Escribir n3
	FinSi
	Si media<n4 Entonces
		Escribir n4
	FinSi
FinAlgoritmo
