Algoritmo sin_titulo
	Escribir 'inserta un caracter'
	Leer car
	Según car Hacer
		'a':
			Escribir 'el caracter es una vocal'
			Escribir 'es la primera vocal (a)'
		'e':
			Escribir 'el caracter es una vocal'
			Escribir 'es la segunda vocal (e)'
		'i':
			Escribir 'el caracter es una vocal'
			Escribir 'es la tercera vocal (i)'
